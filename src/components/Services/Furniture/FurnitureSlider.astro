---

const { blok } = Astro.props;

import FurnitureSlide from './FurnitureSlide.astro'

---

<section class="lg:pt-12">
  <div
    class="container-wrapper overflow-hidden px-4 md:px-8"
  >
  <div><h1 class="text-center" set:html={ blok.title }></h1><p class="text-center"set:html={ blok.description }></p></div>

  <div class="swiper mySwiperFurniture mt-5">
    <div class="swiper-wrapper">

        {blok.images.map(image => <FurnitureSlide {image} />)}

    </div>
    <div class="swiper-pagination-furniture swiper-pagination"></div>
  </div>
    </div>
  </div>
</section>

<style>
  
  .swiper {
      width: 100%;
      padding-bottom: 50px;
      position: relative;
    }

  </style>

<link rel="stylesheet" href="/swiper/swiper-bundle.min.css" />
<script is:inline src="/swiper/swiper-bundle.min.js"></script>

<script>
  
  const swiper = new Swiper(".mySwiperFurniture", {
    breakpoints: {
    // when window width is >= 320px
    640: {
      slidesPerView: 1,
      spaceBetween: 20
    },
    // when window width is >= 480px
    768: {
      slidesPerView: 2,
      spaceBetween: 30
    },
    // when window width is >= 640px
    1024: {
      slidesPerView: 3,
      spaceBetween: 40
    },
    1280: {
      slidesPerView: 3,
      spaceBetween: 40
    }
  },
    grabCursor: true,
      centeredSlides: true,
      loop: true,
      spaceBetween: 30,
      pagination: {
        el: ".swiper-pagination-furniture",
      },
    });
  
  </script>